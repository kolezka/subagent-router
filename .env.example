# subagent-router: local CLIProxyAPI gateway.
# Copy to .env (gitignored) and fill in the real values. Bun loads .env automatically
# when running `bun dist/cli.js ...`, so no export is needed.

# CLIProxyAPI base. MUST end in /v1: the router appends /messages, /messages/count_tokens
# and /models to it. A bare origin sends every forwarded request to the wrong path (404).
CLIPROXYAPI_URL=http://cliproxyapi.app.lan/v1

# Key sent as `Authorization: Bearer <key>` on discovery requests only (GET /v1/models).
CLIPROXYAPI_MODELS_AUTH=sk-cpa-REPLACE_ME

# JSON header map sent on every forwarded request (/v1/messages). Usually the same key.
# Use {"X-Api-Key":"..."} instead if your CLIProxyAPI expects that header.
CLIPROXYAPI_GATEWAY_HEADERS={"Authorization":"Bearer sk-cpa-REPLACE_ME"}

# Random secret for signed hook paths (harness.claudeCode.secretEnv). Generate with:
#   openssl rand -hex 32
ROUTER_SECRET=REPLACE_ME
